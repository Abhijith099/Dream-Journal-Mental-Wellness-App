<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="16dp">

    <!-- Emoji circle badge -->
    <TextView
        android:id="@+id/tvMoodEmoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="😊"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@drawable/bg_mood_unselected"
        android:layout_marginEnd="14dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvMoodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calm"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoodCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="1 dream"
                android:textColor="#9A63FF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/pbMood"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="60"
            android:progressDrawable="@drawable/pb_emotion_gradient" />
    </LinearLayout>
</LinearLayout>
