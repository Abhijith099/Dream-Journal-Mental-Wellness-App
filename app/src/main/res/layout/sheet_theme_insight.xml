<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="18dp"
    android:paddingHorizontal="18dp"
    android:background="#171F4B">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottomsheet_handle" />

    <TextView
        android:id="@+id/tvThemeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theme"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <TextView
        android:id="@+id/tvThemeMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Meaning"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/poppins"
        android:lineSpacingMultiplier="1.2" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="#232C61"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helpful reflection"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/tvThemeReflection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reflection prompt"
                android:textColor="@color/text_card_desc"
                android:textSize="15sp"
                android:fontFamily="@font/poppins"
                android:lineSpacingMultiplier="1.25" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:text="Close"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#171F4B"
        android:fontFamily="@font/poppins"
        app:cornerRadius="18dp"
        app:backgroundTint="@color/glow_primary" />

</LinearLayout>

