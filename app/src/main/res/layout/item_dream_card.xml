<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Month Header (Visible conditionally) -->
    <TextView
        android:id="@+id/tvMonthHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="April"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvDayOfWeek"
        tools:visibility="visible"/>

    <!-- Left Column: Day of Week -->
    <TextView
        android:id="@+id/tvDayOfWeek"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="Sat"
        android:textColor="@color/text_nav"
        android:textSize="14sp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvMonthHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Left Column: Date -->
    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="18"
        android:textColor="@color/text_nav"
        android:textSize="26sp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvDayOfWeek"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Right Column: Card -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/tvDayOfWeek"
        app:layout_constraintStart_toEndOf="@id/tvDayOfWeek"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Card Date -->
        <TextView
            android:id="@+id/tvCardDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17/04/2026"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Card Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I felt scared and sweaty, it is the second time I’m seeing this dream."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="12dp"/>

        <!-- Emotion Tags Container (ChipGroup-like with simple Flex/Horizontal layout) -->
        <LinearLayout
            android:id="@+id/llTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:text="frightened"
                android:textColor="@color/text_tag"
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:text="sweaty"
                android:textColor="@color/text_tag"
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:text="scared"
                android:textColor="@color/text_tag"
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
