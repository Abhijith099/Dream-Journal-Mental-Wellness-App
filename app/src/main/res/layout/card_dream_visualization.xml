<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#232C61"
    app:strokeWidth="1dp"
    app:strokeColor="#1AFFFFFF"
    android:layout_marginBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <ImageView
                android:id="@+id/ivDreamGenerated"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_dream_visualization" />

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/gradient_scrim" />

            <TextView
                android:id="@+id/tvDreamTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="20dp"
                android:text="Dream Visualization"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <!-- Shimmer / Loading Overlay -->
            <FrameLayout
                android:id="@+id/loadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6171F4B"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="#39C6FF"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creating your dream vision..."
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Error Overlay -->
            <LinearLayout
                android:id="@+id/errorOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F2171F4B"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unable to generate image."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Retry Generation"
                    android:textColor="#171F4B"
                    android:backgroundTint="#FF6B9D"
                    app:cornerRadius="22dp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnRegenerate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Regenerate"
                android:textColor="#FFFFFF"
                android:backgroundTint="#33FFFFFF"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins" />

            <Button
                android:id="@+id/btnSaveGallery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Save to Gallery"
                android:textColor="#171F4B"
                android:backgroundTint="#39C6FF"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
