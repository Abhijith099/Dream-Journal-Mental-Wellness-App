<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/simple_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Breathing Exercise"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="A guided inhale and exhale rhythm to help you feel steady and clear."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins"
                android:lineSpacingMultiplier="1.25" />

            <!-- Main breathing animation card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_calm_actions_panel">

                    <!-- Animated breathing circle -->
                    <View
                        android:id="@+id/breathAnimParticle"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:alpha="0.34"
                        android:background="@drawable/bg_calm_particle_cyan" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <ImageView
                            android:id="@+id/breathAnimIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_breathing"
                            app:tint="#BFF4FF"
                            android:contentDescription="Breathing animation" />

                        <!-- Phase label: Inhale / Hold / Exhale -->
                        <TextView
                            android:id="@+id/tvBreathPhase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Inhale"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <!-- Countdown within phase -->
                        <TextView
                            android:id="@+id/tvBreathCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textColor="#BFF4FF"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins" />

                        <!-- Session timer -->
                        <TextView
                            android:id="@+id/tvBreathSessionTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="03:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Inhale  •  Hold  •  Exhale"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Start button (visible when idle) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartBreathing"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:text="Start Breathing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_primary"
                app:cornerRadius="18dp"
                app:backgroundTint="#2A3567"
                app:strokeColor="#39C6FF"
                app:strokeWidth="1dp" />

            <!-- Pause / Stop controls (hidden until session starts) -->
            <LinearLayout
                android:id="@+id/breathControlPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseBreath"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Pause"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="#39C6FF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopBreath"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Stop"
                    android:textAllCaps="false"
                    android:textColor="#FF6B8A"
                    android:fontFamily="@font/poppins"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="#FF6B8A" />
            </LinearLayout>

            <!-- Duration selection row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDur1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="1 min"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins"
                    app:cornerRadius="16dp"
                    app:strokeColor="#2FFFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDur3"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="3 min"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins"
                    app:cornerRadius="16dp"
                    app:strokeColor="#2FFFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDur5"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="5 min"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins"
                    app:cornerRadius="16dp"
                    app:strokeColor="#2FFFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="For best results: keep shoulders soft, jaw relaxed, and breathe through your nose."
                android:textColor="@color/text_card_desc"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:lineSpacingMultiplier="1.25" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
