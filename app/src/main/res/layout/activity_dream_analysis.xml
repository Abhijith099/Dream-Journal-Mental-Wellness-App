<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171F4B"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Your Dream Analysis"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/poppins"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Divider line -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Subtitle label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨  AI-Powered Insights"
                android:textColor="#F6C65B"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:letterSpacing="0.08"
                android:layout_marginBottom="20dp" />

            <!-- CARD 1: Dream Summary -->
            <LinearLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_analysis_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📖  Dream Summary"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivSpeaker"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="Read aloud"
                        app:tint="#39C6FF"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#F6C65B"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingMultiplier="1.7" />

            </LinearLayout>

            <!-- CARD 2: Symbols & Meanings -->
            <LinearLayout
                android:id="@+id/cardSymbols"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_analysis_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔑  Symbols &amp; Meanings"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#F6C65B"
                    android:layout_marginBottom="18dp" />

                <!-- Symbol items injected here programmatically -->
                <LinearLayout
                    android:id="@+id/llSymbols"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Fallback text when no symbols detected -->
                <TextView
                    android:id="@+id/tvNoSymbols"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No specific symbols detected in this dream."
                    android:textColor="#7B88C5"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- CARD 3: Emotional Tone -->
            <LinearLayout
                android:id="@+id/cardEmotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_analysis_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💭  Emotional Tone"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#F6C65B"
                    android:layout_marginBottom="18dp" />

                <!-- Emotion chips injected programmatically -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupEmotions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="4dp" />

                <TextView
                    android:id="@+id/tvEmotionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C5CAE9"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingMultiplier="1.6"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- CARD 4: Reflection Prompt -->
            <LinearLayout
                android:id="@+id/cardReflection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_analysis_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌙  Reflection Prompt"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#F6C65B"
                    android:layout_marginBottom="16dp" />

                <!-- Decorative quote icon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❝"
                    android:textColor="#F6C65B"
                    android:textSize="28sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvReflection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="italic"
                    android:lineSpacingMultiplier="1.7" />

            </LinearLayout>

            <!-- CARD 5: Insight Score -->
            <LinearLayout
                android:id="@+id/cardInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_analysis_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡  Insight Score"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#F6C65B"
                    android:layout_marginBottom="16dp" />

                <!-- Score rows injected programmatically -->
                <LinearLayout
                    android:id="@+id/llInsightScores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom button -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A214D"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnKeepDream"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Keep This Dream  →"
            android:textColor="#1A214D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:backgroundTint="#F6C65B"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
