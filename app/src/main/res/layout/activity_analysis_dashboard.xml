<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171F4B"
    android:fitsSystemWindows="true"
    tools:context=".AnalysisDashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Dreams"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your personal dream intelligence"
                android:textColor="#C5CAE9"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="24dp" />

            <!-- Stats Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Card 1: Total Dreams -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#232C61"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖 Total Dreams"
                            android:textColor="#39C6FF"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvTotalDreamsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            tools:text="26" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dreams Recorded"
                            android:textColor="#C5CAE9"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Overall Emotion -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#232C61"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💛 Overall Emotion"
                            android:textColor="#F6C65B"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvOverallEmotion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:maxLines="2"
                            tools:text="Wonder" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Most Common Mood"
                            android:textColor="#C5CAE9"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Dominant Themes Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 Dominant Themes"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvDominantThemes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keep journaling to reveal your dominant dream themes."
                        android:textColor="#C5CAE9"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingMultiplier="1.4"
                        tools:text="Your dreams often revolve around:\n\nSelf-discovery, inner guidance, authenticity, joy" />

                    <!-- Keyword chips container -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgThemeChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingVertical="8dp"
                        app:chipSpacingHorizontal="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calendar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Calendar Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📅 Calendar"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <ImageView
                            android:id="@+id/ivCalPrev"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_back"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="4dp"
                            app:tint="#C5CAE9"
                            android:contentDescription="Previous month" />

                        <TextView
                            android:id="@+id/tvCalendarMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="April 2026"
                            android:textColor="#C5CAE9"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginHorizontal="4dp" />

                        <ImageView
                            android:id="@+id/ivCalNext"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_back"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="4dp"
                            android:rotation="180"
                            app:tint="#C5CAE9"
                            android:contentDescription="Next month" />

                    </LinearLayout>

                    <!-- Day Names Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="S"
                            android:textColor="#9A63FF" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="M"
                            android:textColor="#C5CAE9" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="T"
                            android:textColor="#C5CAE9" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="W"
                            android:textColor="#C5CAE9" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="T"
                            android:textColor="#C5CAE9" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="F"
                            android:textColor="#C5CAE9" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="S"
                            android:textColor="#9A63FF" android:textSize="13sp"
                            android:gravity="center" android:fontFamily="@font/poppins" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Calendar Grid (populated programmatically) -->
                    <LinearLayout
                        android:id="@+id/llCalendarGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Dream count hint -->
                    <TextView
                        android:id="@+id/tvCalendarHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="center_horizontal"
                        android:text="● = day with dreams"
                        android:textColor="#39C6FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#232C61"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

    <!-- Prominent FAB in Center -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        app:backgroundTint="@color/glow_primary"
        app:tint="@color/white"
        app:elevation="8dp"
        android:src="@drawable/ic_add"
        app:maxImageSize="32dp"
        android:contentDescription="Add Dream" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
