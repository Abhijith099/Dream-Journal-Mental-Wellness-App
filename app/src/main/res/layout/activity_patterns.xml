<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171F4B"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#171F4B"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Patterns"
            app:titleTextColor="#FFFFFF"
            app:titleCentered="true" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:checkedButton="@+id/btnMonth"
            app:singleSelection="true"
            app:selectionRequired="true">

            <Button
                android:id="@+id/btnDay"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textColor="#C5CAE9"
                app:strokeColor="#232C61"
                app:backgroundTint="@color/selector_filter_bg"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMonth"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month"
                android:textColor="#C5CAE9"
                app:strokeColor="#232C61"
                app:backgroundTint="@color/selector_filter_bg"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnYear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Year"
                android:textColor="#C5CAE9"
                app:strokeColor="#232C61"
                app:backgroundTint="@color/selector_filter_bg"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLifetime"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lifetime"
                android:textColor="#C5CAE9"
                app:strokeColor="#232C61"
                app:backgroundTint="@color/selector_filter_bg"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Emotions Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Most Frequent Emotions"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/llEmotionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Keywords Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Most Used Keywords"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgKeywords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dream Factors Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dream Factors"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:alignmentMode="alignMargins">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/cpClarity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorColor="#39C6FF"
                                app:trackColor="#1AFFFFFF"
                                app:indicatorSize="64dp"
                                app:trackThickness="6dp" />
                            <TextView
                                android:id="@+id/tvClarityLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="74% Clarity"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/cpLucidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorColor="#9A63FF"
                                app:trackColor="#1AFFFFFF"
                                app:indicatorSize="64dp"
                                app:trackThickness="6dp" />
                            <TextView
                                android:id="@+id/tvLucidityLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="52% Lucidity"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/cpNightmare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorColor="#FF5252"
                                app:trackColor="#1AFFFFFF"
                                app:indicatorSize="64dp"
                                app:trackThickness="6dp" />
                            <TextView
                                android:id="@+id/tvNightmareLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18% Nightmare"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/cpRecurring"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorColor="#F6C65B"
                                app:trackColor="#1AFFFFFF"
                                app:indicatorSize="64dp"
                                app:trackThickness="6dp" />
                            <TextView
                                android:id="@+id/tvRecurringLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12% Recurring"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mood Graph Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How I Felt"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/moodChart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Numbers Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#232C61"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Numbers"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dreams"
                                android:textColor="#39C6FF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTotalDreams"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: 0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvPeriodDreams"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="In period: 0"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tags"
                                android:textColor="#9A63FF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvUniqueTags"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unique: 0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvAvgTags"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: 0.0"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Words"
                                android:textColor="#F6C65B"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTotalWords"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: 0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvAvgWords"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: 0.0"
                                android:textColor="#C5CAE9"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nightmares"
                                android:textColor="#FF5252"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvPeriodNightmares"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: 0"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Insight Section -->
            <TextView
                android:id="@+id/tvInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your dreams this month focused on growth and uncertainty."
                android:textColor="#C5CAE9"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light"
                android:italic="true"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Empty State Overlay -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#171F4B"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not enough dream data yet"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep journaling to unlock patterns."
            android:textColor="#C5CAE9"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
