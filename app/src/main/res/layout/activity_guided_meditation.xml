<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/med_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- ═══════════════════════════════════════════════════
         Floating particle / star canvas (drawn via code)
         We use a FrameLayout so the custom view overlays
         ═══════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/particleCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════
         Scrollable content
         ═══════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/med_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/med_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- ─── Top App Bar ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/med_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <!-- Live dot indicator -->
                <TextView
                    android:id="@+id/tvLiveIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● LIVE"
                    android:textSize="11sp"
                    android:textColor="#FF5C8D"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/poppins"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ─── Title Area ─────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calm Mind"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meditation"
                android:textColor="#8B5CFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:letterSpacing="-0.02"
                android:layout_marginTop="-6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Relax, breathe, and prepare for restful sleep"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:lineSpacingMultiplier="1.3" />

            <!-- ─── VIDEO CARD ──────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#0D1035"
                app:strokeColor="#558B5CFF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- VideoView container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp">

                        <!-- Video placeholder shown while loading -->
                        <LinearLayout
                            android:id="@+id/videoPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_calm_actions_panel"
                            android:visibility="visible">

                            <View
                                android:id="@+id/placeholderPulse"
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:layout_gravity="center"
                                android:alpha="0.35"
                                android:background="@drawable/bg_calm_particle_purple" />

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:layout_marginTop="-140dp"
                                android:src="@drawable/ic_meditation"
                                app:tint="#D7C6FF"
                                android:contentDescription="Meditation" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Loading meditation..."
                                android:textColor="#90BFC8E8"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <!-- The actual VideoView -->
                        <VideoView
                            android:id="@+id/videoView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="invisible" />

                    </FrameLayout>

                    <!-- ── Duration chip + label row ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_meditation"
                            app:tint="#8B5CFF"
                            android:contentDescription="Duration" />

                        <TextView
                            android:id="@+id/tvDurationLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Duration: —"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#8B5CFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                    <!-- ── Progress bar ── -->
                    <ProgressBar
                        android:id="@+id/videoProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/pb_video_progress"
                        android:max="100" />

                    <!-- ── Playback Controls ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp">

                        <!-- Mute -->
                        <LinearLayout
                            android:id="@+id/btnMute"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:background="@drawable/bg_video_ctrl_btn"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/iconMute"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_unmute"
                                app:tint="#BFC8E8"
                                android:contentDescription="Mute" />
                        </LinearLayout>

                        <!-- Pause / Play -->
                        <LinearLayout
                            android:id="@+id/btnPlayPause"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:gravity="center"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/bg_calm_particle_purple"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/iconPlayPause"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_pause"
                                app:tint="#FFFFFF"
                                android:contentDescription="Play / Pause" />
                        </LinearLayout>

                        <!-- Fullscreen -->
                        <LinearLayout
                            android:id="@+id/btnFullscreen"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:background="@drawable/bg_video_ctrl_btn"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_analysis"
                                app:tint="#BFC8E8"
                                android:contentDescription="Fullscreen" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- ── STOP MEDITATION button ── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopMeditation"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="Stop Meditation"
                        android:textAllCaps="false"
                        android:textColor="#FF6B8A"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        app:cornerRadius="16dp"
                        app:strokeColor="#FF6B8A"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Loop Status chip ────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvLoopStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="🔁  Auto-looping — playing continuously"
                    android:textColor="#80D7C6FF"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:background="@drawable/bg_tag" />

            </LinearLayout>

            <!-- ─── SECTION: Quick Options ─────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="14dp"
                android:text="Quick Options"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <!-- Row 1: Deep Breathing + Reduce Anxiety -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Deep Breathing -->
                <LinearLayout
                    android:id="@+id/optDeepBreathing"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_quick_option_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconBreathing"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_deep_breath"
                        android:contentDescription="Deep Breathing" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Deep Breathing"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Slow &amp; steady"
                        android:textColor="@color/text_card_desc"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Reduce Anxiety -->
                <LinearLayout
                    android:id="@+id/optReduceAnxiety"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_quick_option_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconAnxiety"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_reduce_anxiety"
                        android:contentDescription="Reduce Anxiety" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Reduce Anxiety"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Find inner peace"
                        android:textColor="@color/text_card_desc"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: Clear Thoughts + Prepare for Sleep -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Clear Thoughts -->
                <LinearLayout
                    android:id="@+id/optClearThoughts"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_quick_option_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconThoughts"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_clear_thoughts"
                        android:contentDescription="Clear Thoughts" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Clear Thoughts"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Empty your mind"
                        android:textColor="@color/text_card_desc"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Prepare for Sleep -->
                <LinearLayout
                    android:id="@+id/optPrepareSleep"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_quick_option_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconSleep"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_prepare_sleep"
                        android:contentDescription="Prepare for Sleep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Prepare for Sleep"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Wind down gently"
                        android:textColor="@color/text_card_desc"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- ─── Tip card ────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1D40"
                app:strokeColor="#2A8B5CFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Use headphones and lower your brightness for the most immersive experience."
                        android:textColor="@color/text_card_desc"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
