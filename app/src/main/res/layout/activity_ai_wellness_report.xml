<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_wellness_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".AnalysisDashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Wellness Report"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Insight based on your recent dream patterns"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyze"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:text="Analyze"
                    android:textSize="14sp"
                    android:textColor="@color/glow_primary"
                    android:fontFamily="@font/poppins"
                    app:icon="@drawable/ic_insights"
                    app:iconTint="@color/glow_primary"
                    app:backgroundTint="#232C61"
                    app:strokeColor="@color/glow_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoodStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg_alt"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivMoodIllustration"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_calm"
                        android:contentDescription="Mood illustration"
                        app:tint="@color/glow_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMoodStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mood Stable"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvMoodStatusDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Your recent dreams suggest steady emotional tone with manageable stress."
                            android:textColor="@color/text_card_desc"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins"
                            android:lineSpacingMultiplier="1.25" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stress score + Sleep quality -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStressScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stress Score"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:layout_marginBottom="12dp" />

                        <FrameLayout
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_gravity="start">

                            <ProgressBar
                                android:id="@+id/pbStressCircle"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="35"
                                android:progressDrawable="@drawable/bg_circle_progress" />

                            <TextView
                                android:id="@+id/tvStressValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="35"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvStressLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Moderate stress level"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSleepQuality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sleep Quality"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tvSleepScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="78"
                            android:textColor="@color/text_primary"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvSleepDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Estimate based on dream disturbances and recurring fear patterns."
                            android:textColor="@color/text_card_desc"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Dream mood trend -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoodTrend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dream Mood Trend"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="12dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartMoodTrend"
                        android:layout_width="match_parent"
                        android:layout_height="170dp" />

                    <TextView
                        android:id="@+id/tvTrendHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Based on your last 3 entries"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recurring themes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recurring Themes"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvThemesDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap a theme for a short meaning and a helpful reflection."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgThemes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="10dp"
                        app:chipSpacingVertical="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calm actions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_calm_actions_panel"
                    android:clipToOutline="true">

                    <!-- Ambient aura / particles (subtle, animated in code) -->
                    <View
                        android:id="@+id/caParticleA"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="14dp"
                        android:alpha="0.55"
                        android:background="@drawable/bg_calm_particle_purple" />

                    <View
                        android:id="@+id/caParticleB"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.38"
                        android:background="@drawable/bg_calm_particle_cyan" />

                    <View
                        android:id="@+id/caParticleC"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center|end"
                        android:layout_marginEnd="18dp"
                        android:alpha="0.22"
                        android:background="@drawable/bg_calm_particle_amber" />

                    <LinearLayout
                        android:id="@+id/caContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Header with subtle wave -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp">

                            <View
                                android:id="@+id/caWave"
                                android:layout_width="match_parent"
                                android:layout_height="34dp"
                                android:layout_gravity="center_vertical"
                                android:alpha="0.40"
                                android:background="@drawable/bg_calm_wave_line" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/caTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Calm Actions"
                                    android:textColor="@color/text_primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins" />

                                <TextView
                                    android:id="@+id/caSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Immediate tools to support your wellbeing"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/poppins"
                                    android:lineSpacingMultiplier="1.15" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Tile 1: Guided Meditation -->
                        <FrameLayout
                            android:id="@+id/tileMeditation"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_calm_tile_purple"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <View
                                android:id="@+id/haloMeditation"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|center_vertical"
                                android:background="@drawable/bg_calm_halo_purple"
                                android:alpha="0.0" />

                            <ImageView
                                android:id="@+id/iconMeditation"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_meditation"
                                app:tint="#D7C6FF"
                                android:contentDescription="Guided Meditation" />

                            <TextView
                                android:id="@+id/btnMeditation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="52dp"
                                android:text="Guided Meditation"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                        <!-- Tile 2: Breathing Exercise -->
                        <FrameLayout
                            android:id="@+id/tileBreathing"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_calm_tile_cyan"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <View
                                android:id="@+id/haloBreathing"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|center_vertical"
                                android:background="@drawable/bg_calm_halo_cyan"
                                android:alpha="0.0" />

                            <ImageView
                                android:id="@+id/iconBreathing"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_breathing"
                                app:tint="#BFF4FF"
                                android:contentDescription="Breathing Exercise" />

                            <TextView
                                android:id="@+id/btnBreathing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="52dp"
                                android:text="Breathing Exercise"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                        <!-- Tile 3: Sleep Sounds -->
                        <FrameLayout
                            android:id="@+id/tileSleepSounds"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_calm_tile_moon"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:id="@+id/equalizerWrap"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|center_vertical"
                                android:gravity="center"
                                android:orientation="horizontal">
                                <View
                                    android:id="@+id/eq1"
                                    android:layout_width="4dp"
                                    android:layout_height="14dp"
                                    android:layout_marginHorizontal="2dp"
                                    android:background="@drawable/bg_eq_bar" />
                                <View
                                    android:id="@+id/eq2"
                                    android:layout_width="4dp"
                                    android:layout_height="20dp"
                                    android:layout_marginHorizontal="2dp"
                                    android:background="@drawable/bg_eq_bar" />
                                <View
                                    android:id="@+id/eq3"
                                    android:layout_width="4dp"
                                    android:layout_height="16dp"
                                    android:layout_marginHorizontal="2dp"
                                    android:background="@drawable/bg_eq_bar" />
                                <View
                                    android:id="@+id/eq4"
                                    android:layout_width="4dp"
                                    android:layout_height="22dp"
                                    android:layout_marginHorizontal="2dp"
                                    android:background="@drawable/bg_eq_bar" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/iconSleepSounds"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="52dp"
                                android:src="@drawable/ic_sleep_sounds"
                                app:tint="#D7E6FF"
                                android:contentDescription="Sleep Sounds" />

                            <TextView
                                android:id="@+id/btnSleepSounds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="86dp"
                                android:text="Sleep Sounds"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                        <!-- Tile 4: Journal Thoughts -->
                        <FrameLayout
                            android:id="@+id/tileJournalThoughts"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_calm_tile_amber"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|center_vertical">

                                <View
                                    android:id="@+id/shimmerJournal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_shimmer_sweep"
                                    android:alpha="0.0" />

                                <ImageView
                                    android:id="@+id/iconJournalThoughts"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_journal_thoughts"
                                    app:tint="#FFE4A8"
                                    android:contentDescription="Journal Thoughts" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/btnJournalThoughts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="52dp"
                                android:text="Journal Thoughts"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                        <!-- Emergency CTA (premium, full-width) -->
                        <FrameLayout
                            android:id="@+id/btnImmediateSupport"
                            android:layout_width="match_parent"
                            android:layout_height="66dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_emergency_support"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">

                            <View
                                android:id="@+id/emergencyPulse"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_emergency_pulse_border"
                                android:alpha="0.0" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center_vertical|start"
                                android:src="@drawable/ic_support_shield"
                                app:tint="#FFFFFF"
                                android:contentDescription="Immediate support" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Need Immediate Support"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />
                        </FrameLayout>

                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's advice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today’s Advice"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/llAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mood support (conditional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoodSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="#2A3567"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mood Support"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/llMoodSupport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Emergency (conditional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="#3A1B22"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvEmergencyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Need Immediate Support?"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvEmergencyDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="If you feel unsafe or overwhelmed, reach out now."
                        android:textColor="#F4D7DC"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingMultiplier="1.2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallHelpline"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:text="Call Helpline"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="18dp"
                        app:backgroundTint="#B4232E" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallEmergencyContact"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:text="Call Emergency Contact"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="18dp"
                        app:backgroundTint="#7C2A34" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMessageTrusted"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:text="Message Trusted Contact"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="18dp"
                        app:backgroundTint="#7C2A34" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#232C61"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

    <!-- Prominent FAB in Center -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        app:backgroundTint="@color/glow_primary"
        app:tint="@color/white"
        app:elevation="8dp"
        android:src="@drawable/ic_add"
        app:maxImageSize="32dp"
        android:contentDescription="Add Dream" />

    <!-- Premium loading overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC0D1433"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp">

            <ImageView
                android:id="@+id/ivLoadingAnim"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/avd_neural_pulse"
                android:contentDescription="Analyzing animation" />

            <TextView
                android:id="@+id/tvLoadingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Analyzing your last 3 dream entries"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvLoadingSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Building emotional insights and helpful actions"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:gravity="center" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressAnalyze"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="18dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                app:trackCornerRadius="20dp"
                app:indicatorColor="@color/glow_primary"
                app:trackColor="#2A3567" />

            <TextView
                android:id="@+id/tvLoadingPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0%"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

