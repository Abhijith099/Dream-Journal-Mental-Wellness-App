<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#33D7C6FF" />
        </shape>
    </item>
    <item android:left="-30dp" android:top="-24dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerColor="#338B5CFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#408B5CFF" />
        </shape>
    </item>
</layer-list>

