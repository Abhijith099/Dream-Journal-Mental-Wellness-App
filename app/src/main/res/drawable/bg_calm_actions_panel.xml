<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep premium base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#232C61"
                android:centerColor="#1C2556"
                android:endColor="#141B3F"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Subtle glass layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Corner glows -->
    <item android:left="-40dp" android:top="-40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerColor="#2A39C6FF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item android:right="-50dp" android:bottom="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerColor="#228B5CFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Hairline stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>

</layer-list>

